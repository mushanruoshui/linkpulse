# 复制为 .env 后填写真实值
#   cp .env.example .env
# .env 已被 .gitignore 排除，不会提交到仓库
#   这条约定叫「配置与代码分离」（12-Factor App 第 3 条）

APP_NAME=LinkPulse
APP_ENV=development
DEBUG=true

# W2 起启用
# DATABASE_URL=mysql+pymysql://linkpulse:password@127.0.0.1:3306/linkpulse
# REDIS_URL=redis://127.0.0.1:6379/0

# W5 起启用
# CACHE_TTL_SECONDS=3600
